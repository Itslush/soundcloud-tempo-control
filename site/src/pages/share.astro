---
import Page from '../layouts/Page.astro';
import { installUrl, route, release } from '../lib/release';
import TimelineDemo from '../components/TimelineDemo.astro';
---

<Page title="Shared track">
  <article
    class="reading shell shared-page"
    id="shared-track"
    data-website={release.siteUrl}
  >
    <h1>Shared track</h1>
    <p id="share-summary" role="status">Reading the shared settings…</p>
    <noscript
      >Enable JavaScript to read this link and play its shared settings.</noscript
    >
    <div id="share-actions" hidden>
      <p>Play here with the shared tempo and pitch. No plugin needed.</p>
      <TimelineDemo shared />
      <details id="discord-sharing" class="shared-install">
        <summary>Share in Discord</summary>
        <p class="discord-notice">
          Discord's player can currently get stuck at 0:00. If that happens,
          open the shared-track page to listen.
        </p>
        <p>
          Create a playable copy with this link's tempo and pitch settings. The
          audio will be public for seven days. Only create a link if you have
          permission to share the audio. Tracks can be up to 15 minutes, or 30
          minutes after adjustment.
        </p>
        <button class="button discord-create" type="button"
          >Create public Discord link</button
        >
        <p class="discord-status" role="status" aria-live="polite"></p>
        <div class="discord-result" hidden>
          <a class="discord-link"></a>
          <button class="button discord-copy" type="button"
            >Copy Discord link</button
          >
        </div>
      </details>
      <details class="shared-install">
        <summary>Use these settings on SoundCloud</summary>
        <p>
          <a href={installUrl}>Install Tempo Control</a> · <a
            href={route('guide/')}>Installation help</a
          >
        </p>
        <p><a id="share-adjusted">Open with the shared settings</a></p>
      </details>
      <p><a id="share-original">Listen on SoundCloud without changes</a></p>
    </div>
  </article>
</Page>
<script>
  import {
    decodeTempoCode,
    encodeTempoCode,
  } from '../../../src/tempo-share.js';
  import { validateProfile } from '../../../src/tempo-profile.js';
  import { initDemo } from '../scripts/demo';
  import { initDiscordShare } from '../scripts/discord-share';
  const root = document.querySelector<HTMLElement>('#shared-track')!;
  const summary = document.querySelector<HTMLElement>('#share-summary')!;
  const parseTrack = (path: string) =>
    /^\/[a-zA-Z0-9_-]+\/[a-zA-Z0-9_-]+$/.test(path) ? path : '';
  try {
    const code = location.hash.startsWith('#sct=')
      ? location.hash.slice(5)
      : '';
    const data = decodeTempoCode(
      code,
      (value) => validateProfile(value, parseTrack),
      parseTrack,
      root.dataset.website,
    );
    const original = 'https://soundcloud.com' + data.track;
    summary.textContent =
      data.track.slice(1).replace('/', ' / ') +
      ' · ' +
      (data.points.length > 1 ? 'Tempo timeline' : data.points[0].r + '×') +
      ' · ' +
      (data.pitchPoints ? 'Pitch timeline' : (data.keyShift ?? 0) + ' st');
    document.querySelector<HTMLAnchorElement>('#share-original')!.href =
      original;
    document.querySelector<HTMLAnchorElement>('#share-adjusted')!.href =
      original + '?sct=' + encodeTempoCode(data);
    document.querySelector<HTMLElement>('#share-actions')!.hidden = false;
    initDemo(data);
    initDiscordShare(encodeTempoCode(data));
  } catch {
    summary.textContent =
      'The tempo settings in this link are missing or invalid. Ask for a new copy of the link.';
  }
  window.addEventListener('hashchange', () => location.reload());
</script>

<style>
  .shared-page {
    max-width: 1100px;
  }
  .shared-install {
    margin-top: 24px;
  }
  .shared-install summary {
    cursor: pointer;
    padding-block: 12px;
  }
  #share-summary {
    overflow-wrap: anywhere;
  }
  .discord-result {
    display: flex;
    align-items: start;
    flex-direction: column;
    gap: 12px;
  }
  .discord-link {
    overflow-wrap: anywhere;
    max-width: 100%;
  }
</style>
