---
import '@fontsource-variable/mulish';
import '../styles/site.css';
import '../styles/preview.css';
import Logo from '../components/Logo.astro';
import SpaceAccent from '../components/SpaceAccent.astro';
import Donations from '../components/Donations.astro';
import { release, route } from '../lib/release';
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Change playback speed on SoundCloud. Save speeds for individual tracks and share tempo timelines.',
} = Astro.props;
const links = [
  ['Download', ''],
  ['Updates', 'updates/'],
  ['Help', 'guide/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <title>
      {
        title
          ? `${title} · SoundCloud Tempo Control`
          : 'SoundCloud Tempo Control'
      }
    </title>
    <link rel="icon" type="image/svg+xml" href={route('favicon.svg')} />
    {
      release.siteUrl && (
        <link
          rel="canonical"
          href={new URL(Astro.url.pathname, release.siteUrl)}
        />
      )
    }
  </head>
  <body>
    <SpaceAccent />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner shell">
        <a class="brand" href={route()} aria-label="Tempo Control home"
          ><Logo /><strong>Tempo Control</strong></a
        >
        <nav aria-label="Main navigation">
          {
            links.map(([label, path]) => (
              <a
                href={route(path)}
                aria-current={
                  Astro.url.pathname === route(path) ? 'page' : undefined
                }
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <Donations />
    <details class="site-appearance shell" hidden>
      <summary
        >Appearance <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          aria-hidden="true"
          ><path
            d="m4 6 4 4 4-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></path></svg
        ></summary
      >
      <button
        class="button"
        id="site-star-motion"
        type="button"
        aria-pressed="false">Animate stars</button
      >
      <p id="site-star-status" role="status"></p>
    </details>
    <footer class="site-footer shell">
      <p>Unofficial. Not affiliated with SoundCloud.</p>
      <nav aria-label="Footer navigation">
        <a href={route('privacy/')}>Privacy</a>{
          release.repositoryUrl && (
            <a href={release.repositoryUrl} rel="noopener noreferrer">
              Source
            </a>
          )
        }<a href={route('guide/')}>Help</a>
      </nav>
    </footer>
  </body>
</html>
