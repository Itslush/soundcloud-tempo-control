---
import Icon from './Icon.astro';
import Select from './Select.astro';
import NumberField from './NumberField.astro';
import { demoTrack } from '../lib/demo-track';
---

<figure
  class="timeline-demo"
  data-mode="timeline"
  data-compare="adjusted"
  data-playback="idle"
>
  <div class="demo-surface">
    <header class="demo-heading">
      <strong>Preview</strong>
    </header>
    <div class="preview-meta">
      <span id="preview-title">{demoTrack.title}</span>
    </div>
    <div class="preview-transport">
      <button type="button" id="preview-play">Play</button>
      <output id="preview-readout" aria-label="Current playback"
        >0:00 · 1× now</output
      >
      <button type="button" id="preview-compare" aria-pressed="false" disabled
        >Listen to original</button
      >
      <label class="preview-volume"
        >Volume<input
          type="range"
          id="preview-volume"
          min="0"
          max="0.5"
          step="0.01"
          value="0.15"
        /></label
      >
    </div>
    <label class="preview-seek"
      ><span class="sr-only">Playback position</span><input
        id="preview-seek"
        type="range"
        min="0"
        max="24"
        step="0.1"
        value="0"
        disabled
      /></label
    >
    <div class="preview-mode-row">
      <div class="preview-mode" role="group" aria-label="Playback mode">
        <button id="preview-fixed" type="button" aria-pressed="false"
          >Fixed speed</button
        >
        <button id="preview-timeline" type="button" aria-pressed="true"
          >Timeline</button
        >
      </div>
      <input
        id="preview-follow"
        type="checkbox"
        checked
        hidden
        aria-label="Follow timeline"
      />
      <Select
        id="demo-pitch"
        label="Demo pitch mode"
        prefix="Pitch:"
        value="natural"
        options={[
          { value: 'natural', label: 'Natural' },
          { value: 'preserve', label: 'Preserve key' },
        ]}
      />
      <button type="button" id="demo-copy" disabled
        ><Icon name="link" size={18} /><span id="demo-copy-label"
          >Copy link</span
        ></button
      >
    </div>
    <div id="preview-fixed-controls" hidden>
      {
        [
          {
            id: 'demo-speed-number',
            slider: 'demo-speed',
            label: 'Tempo',
            value: 1,
            min: 0.25,
            max: 4,
            step: 0.025,
            unit: '×',
          },
          {
            id: 'demo-key-shift',
            slider: 'demo-key-slider',
            label: 'Key shift',
            value: 0,
            min: -12,
            max: 12,
            step: 0.5,
            unit: 'st',
          },
        ].map(({ slider, ...control }) => (
          <div class="fixed-adjustment">
            <NumberField {...control} visibleLabel />
            <div class="adjustment-rail">
              <input
                id={slider}
                type="range"
                min={control.min}
                max={control.max}
                step={control.step}
                value={control.value}
                aria-label={`${control.label} slider`}
              />
              <div class="adjustment-limits" aria-hidden="true">
                <>
                  <span>
                    {control.min}
                    {control.unit}
                  </span>
                  <span>
                    {control.max}
                    {control.unit}
                  </span>
                </>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div id="demo-shared-editor"></div>
    <details class="demo-details" id="preview-loader">
      <summary>Try your own track</summary>
      <form id="preview-link-form">
        <label for="preview-url">SoundCloud link</label>
        <div class="preview-link-row">
          <input
            id="preview-url"
            type="url"
            placeholder="https://soundcloud.com/artist/track"
            required
            maxlength="2048"
          />
          <button type="submit">Load</button>
        </div>
      </form>
      <label class="preview-file"
        >Or choose an audio file<input
          id="preview-file"
          type="file"
          accept="audio/*,.flac,.wav,.mp3,.m4a,.ogg"
        /></label
      >
      <a id="preview-credit" hidden target="_blank" rel="noopener noreferrer"
        >Listen on SoundCloud</a
      >
    </details>
    <button type="button" id="preview-sample" class="preview-fallback" hidden
      >Use synth sample</button
    >
  </div>
  <figcaption id="demo-status" role="status"></figcaption>
  <textarea
    id="demo-copy-fallback"
    aria-label="Select and copy the tempo link"
    readonly
    hidden></textarea>
  <noscript
    ><p>
      The interactive preview needs JavaScript. Downloads and guides still work.
    </p></noscript
  >
</figure>
<script src="../scripts/demo.ts"></script>
