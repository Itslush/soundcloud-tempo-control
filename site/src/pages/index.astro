---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import TimelineDemo from '../components/TimelineDemo.astro';
import Capture from '../components/Capture.astro';
import CaptureViewer from '../components/CaptureViewer.astro';
import { installUrl, route, release } from '../lib/release';
---

<Page>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Change the speed<br />{' '}of a SoundCloud track.</h1><p>
        Save a speed for each track, or draw a timeline that changes it as you listen.
      </p><div class="hero-actions">
        <a class="button primary" href={installUrl}
          ><Icon name="download" />Install userscript</a
        ><a class="text-link" href="#install"
          >Setup guide<Icon name="arrow" size={20} /></a
        >
      </div>
    </div>
    <TimelineDemo />
  </section>
  <section class="product-proof shell" aria-labelledby="proof-title">
    <article class="proof-row proof-player">
      <div class="proof-copy">
        <h2 id="proof-title">Change speed in the player</h2>
        <p>Set a speed. Tap the bookmark to remember it for that track.</p>
      </div>
      <Capture
        image="player-controls.png"
        title="Tempo controls in SoundCloud"
        variant="capture-player"
        alt="SoundCloud player at 0.9× speed, with adjustment arrows, tempo slider, saved bookmark and settings."
      />
    </article>
    <article class="proof-row">
      <div class="proof-copy">
        <h2>Set changes over time</h2>
        <p>
          Start at 1×, slow to 0.75×, then ease back to 0.90×. Set the fade
          duration for each change.
        </p>
      </div>
      <Capture
        image="timeline-curve.png"
        mobile="timeline-detail.png"
        title="Saved tempo timeline"
        variant="capture-timeline"
        alt="A saved tempo curve from 1× to 0.75× and back to 0.9×, joined by gradual fades."
      />
    </article>
    <article class="proof-row">
      <div class="proof-copy">
        <h2>Keep a speed for each track</h2>
        <p>Saved speeds apply when you return to a track. Change or remove them in settings.</p>
      </div>
      <Capture
        image="saved-tracks.png"
        mobile="saved-tracks-mobile.png"
        title="Saved track tempos"
        variant="capture-memory"
        alt="One track with a saved 0.9× speed and tempo timeline in the settings panel."
      />
    </article>
    <article class="proof-row">
      <div class="proof-copy">
        <h2>Share a timeline</h2>
        <p>
          Copy a link with your tempo and pitch changes. Whoever opens it can
          preview the settings, apply them once or save the timeline.
        </p>
        <p class="proof-detail">
          Both listeners need Tempo Control. <a href={route('guide/#sharing')}
            >How sharing works</a
          >
        </p>
      </div>
      <Capture
        image="share-actions.png"
        mobile="share-actions-mobile.png"
        title="Receiving a shared timeline"
        variant="capture-sharing"
        alt="The received-link preview with enabled Apply once and Save timeline buttons."
      />
    </article>
  </section>
  <section
    class="install-section shell"
    id="install"
    aria-labelledby="install-title"
  >
    <div>
      <h2 id="install-title">Install Tempo Control</h2><a class="text-link" href={route('guide/')}
        >Full setup guide<Icon name="arrow" size={20} /></a
      >
    </div>
    <ol class="install-steps">
      <li>
        <h3>Get Violentmonkey</h3><p>
          A userscript manager runs Tempo Control in your browser.
        </p><a
          href="https://violentmonkey.github.io/get-it/"
          target="_blank"
          rel="noopener noreferrer"
          >Get Violentmonkey<Icon name="external" size={15} /></a
        >
      </li>
      <li>
        <h3>Install Tempo Control</h3><p>
          Open the script, then confirm the installation in your manager.
        </p><a href={installUrl}
          >Install v{release.version}<Icon name="download" size={16} /></a
        >
      </li>
      <li>
        <h3>Open SoundCloud</h3><p>
          Reload the page and choose a track. The tempo slider sits in the
          player.
        </p><a
          href="https://soundcloud.com/"
          target="_blank"
          rel="noopener noreferrer"
          >Open SoundCloud<Icon name="external" size={15} /></a
        >
      </li>
    </ol>
  </section>
  <CaptureViewer />
</Page>
